{
  "title": "Connectivity Link — Gateway overview",
  "uid": "cl-gateway-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(istio_requests_total{destination_service_name=~\".+\"}, destination_service_namespace)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "route",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(istio_requests_total{destination_service_namespace=~\"$namespace\"}, destination_service_name)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Request rate",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(istio_requests_total{reporter=\"destination\", destination_service_namespace=~\"$namespace\", destination_service_name=~\"$route\"}[5m]))",
          "legendFormat": "req/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 1 }, "overrides": [] }
    },
    {
      "id": 2,
      "title": "Error rate (5xx)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "100 * sum(rate(istio_requests_total{reporter=\"destination\", destination_service_namespace=~\"$namespace\", destination_service_name=~\"$route\", response_code=~\"5..\"}[5m])) / sum(rate(istio_requests_total{reporter=\"destination\", destination_service_namespace=~\"$namespace\", destination_service_name=~\"$route\"}[5m]))",
          "legendFormat": "5xx %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "p99 latency",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(istio_request_duration_milliseconds_bucket{reporter=\"destination\", destination_service_namespace=~\"$namespace\", destination_service_name=~\"$route\"}[5m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "decimals": 0 }, "overrides": [] }
    },
    {
      "id": 4,
      "title": "4xx rate",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "100 * sum(rate(istio_requests_total{reporter=\"destination\", destination_service_namespace=~\"$namespace\", destination_service_name=~\"$route\", response_code=~\"4..\"}[5m])) / sum(rate(istio_requests_total{reporter=\"destination\", destination_service_namespace=~\"$namespace\", destination_service_name=~\"$route\"}[5m]))",
          "legendFormat": "4xx %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Requests by backend",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        {
          "expr": "sum(rate(istio_requests_total{reporter=\"destination\", destination_service_namespace=~\"$namespace\", destination_service_name=~\"$route\"}[5m])) by (destination_service_name)",
          "legendFormat": "{{destination_service_name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 6,
      "title": "5xx errors by backend",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [
        {
          "expr": "sum(rate(istio_requests_total{reporter=\"destination\", destination_service_namespace=~\"$namespace\", destination_service_name=~\"$route\", response_code=~\"5..\"}[5m])) by (destination_service_name)",
          "legendFormat": "{{destination_service_name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 7,
      "title": "p50 / p90 / p99 latency by backend",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 13 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(istio_request_duration_milliseconds_bucket{reporter=\"destination\", destination_service_namespace=~\"$namespace\", destination_service_name=~\"$route\"}[5m])) by (le, destination_service_name))",
          "legendFormat": "p50 {{destination_service_name}}"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(istio_request_duration_milliseconds_bucket{reporter=\"destination\", destination_service_namespace=~\"$namespace\", destination_service_name=~\"$route\"}[5m])) by (le, destination_service_name))",
          "legendFormat": "p90 {{destination_service_name}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(istio_request_duration_milliseconds_bucket{reporter=\"destination\", destination_service_namespace=~\"$namespace\", destination_service_name=~\"$route\"}[5m])) by (le, destination_service_name))",
          "legendFormat": "p99 {{destination_service_name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] }
    },
    {
      "id": 8,
      "title": "Backend summary (table)",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 21 },
      "targets": [
        {
          "expr": "sum(rate(istio_requests_total{reporter=\"destination\", destination_service_namespace=~\"$namespace\", destination_service_name=~\"$route\"}[5m])) by (destination_service_name)",
          "format": "table",
          "instant": true,
          "legendFormat": "req/s"
        },
        {
          "expr": "100 * sum(rate(istio_requests_total{reporter=\"destination\", destination_service_namespace=~\"$namespace\", destination_service_name=~\"$route\", response_code=~\"5..\"}[5m])) by (destination_service_name) / sum(rate(istio_requests_total{reporter=\"destination\", destination_service_namespace=~\"$namespace\", destination_service_name=~\"$route\"}[5m])) by (destination_service_name)",
          "format": "table",
          "instant": true,
          "legendFormat": "err %"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(istio_request_duration_milliseconds_bucket{reporter=\"destination\", destination_service_namespace=~\"$namespace\", destination_service_name=~\"$route\"}[5m])) by (le, destination_service_name))",
          "format": "table",
          "instant": true,
          "legendFormat": "p99 ms"
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} }
      ]
    },
    {
      "id": 9,
      "title": "Gateways not Accepted",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 29 },
      "targets": [
        {
          "expr": "count(gatewayapi_gateway_status{namespace=~\"$namespace\", type=\"Accepted\"} == 0)",
          "legendFormat": "not accepted"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Listeners with 0 attached routes",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 29 },
      "targets": [
        {
          "expr": "count(gatewayapi_gateway_status_listener_attached_routes{namespace=~\"$namespace\"} == 0)",
          "legendFormat": "empty listeners"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Total attached routes",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 29 },
      "targets": [
        {
          "expr": "sum(gatewayapi_gateway_status_listener_attached_routes{namespace=~\"$namespace\"})",
          "legendFormat": "attached routes"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 12,
      "title": "HTTPRoutes without a Programmed parent",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 29 },
      "targets": [
        {
          "expr": "count(gatewayapi_httproute_parent_info{namespace=~\"$namespace\"}) - count(gatewayapi_httproute_status_parent_info{namespace=~\"$namespace\"})",
          "legendFormat": "unattached"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "title": "Gateway status",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Accepted / Programmed status per Gateway, joined with class and address",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 34 },
      "targets": [
        { "expr": "gatewayapi_gateway_info{namespace=~\"$namespace\"}", "format": "table", "instant": true, "legendFormat": "info" },
        { "expr": "gatewayapi_gateway_status{namespace=~\"$namespace\", type=\"Accepted\"}", "format": "table", "instant": true, "legendFormat": "accepted" },
        { "expr": "gatewayapi_gateway_status{namespace=~\"$namespace\", type=\"Programmed\"}", "format": "table", "instant": true, "legendFormat": "programmed" }
      ],
      "transformations": [{ "id": "merge", "options": {} }]
    },
    {
      "id": 14,
      "title": "Listeners — attached routes",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 34 },
      "targets": [
        { "expr": "gatewayapi_gateway_listener_info{namespace=~\"$namespace\"}", "format": "table", "instant": true, "legendFormat": "listener" },
        { "expr": "gatewayapi_gateway_status_listener_attached_routes{namespace=~\"$namespace\"}", "format": "table", "instant": true, "legendFormat": "attached" }
      ],
      "transformations": [{ "id": "merge", "options": {} }]
    },
    {
      "id": 15,
      "title": "HTTPRoutes — desired vs actual attachment",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "parent_info = what the HTTPRoute asks to attach to. status_parent_info = what it is actually attached to, per its status. A route present in the first but missing from the second failed to attach.",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 41 },
      "targets": [
        { "expr": "gatewayapi_httproute_hostname_info{namespace=~\"$namespace\"}", "format": "table", "instant": true, "legendFormat": "hostname" },
        { "expr": "gatewayapi_httproute_parent_info{namespace=~\"$namespace\"}", "format": "table", "instant": true, "legendFormat": "wants" },
        { "expr": "gatewayapi_httproute_status_parent_info{namespace=~\"$namespace\"}", "format": "table", "instant": true, "legendFormat": "attached" }
      ],
      "transformations": [{ "id": "merge", "options": {} }]
    }
  ]
}
