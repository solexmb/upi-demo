{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "OpenShift user-workload Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" },
    { "type": "panel", "id": "alertlist", "name": "Alert list", "version": "" }
  ],
  "annotations": {
    "list": [
      {
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "enable": true,
        "expr": "changes(probe_success{instance=~\"$target\"}[10m]) > 0",
        "iconColor": "#E24B4A",
        "name": "Status changes",
        "titleFormat": "Probe status changed",
        "type": "alert"
      }
    ]
  },
  "description": "Blackbox Exporter uptime dashboard — probe success, latency, TLS expiry, HTTP status codes.",
  "editable": true,
  "panels": [

    {
      "id": 1,
      "type": "stat",
      "title": "Probe success",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "justifyMode": "center" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "probe_success{instance=~\"$target\", job=~\"$job\"}", "instant": true, "legendFormat": "{{instance}}" }]
    },

    {
      "id": 2,
      "type": "stat",
      "title": "Uptime % (selected range)",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 95 }, { "color": "green", "value": 99 }] },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["mean"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "avg_over_time(probe_success{instance=~\"$target\", job=~\"$job\"}[$__range]) * 100", "instant": true, "legendFormat": "uptime" }]
    },

    {
      "id": 3,
      "type": "stat",
      "title": "Probe duration",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 2 }] },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "probe_duration_seconds{instance=~\"$target\", job=~\"$job\"}", "instant": true, "legendFormat": "{{instance}}" }]
    },

    {
      "id": 4,
      "type": "stat",
      "title": "HTTP status code",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "range", "options": { "from": 200, "to": 299, "result": { "color": "green" } } },
            { "type": "range", "options": { "from": 300, "to": 399, "result": { "color": "blue" } } },
            { "type": "range", "options": { "from": 400, "to": 599, "result": { "color": "red" } } },
            { "type": "value", "options": { "0": { "text": "No response", "color": "red" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 200 }] },
          "color": { "mode": "thresholds" },
          "decimals": 0
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "probe_http_status_code{instance=~\"$target\", job=~\"$job\"}", "instant": true, "legendFormat": "{{instance}}" }]
    },

    {
      "id": 5,
      "type": "stat",
      "title": "TLS cert expiry",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 14 }, { "color": "green", "value": 30 }] },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "(probe_ssl_earliest_cert_expiry{instance=~\"$target\", job=~\"$job\"} - time()) / 86400", "instant": true, "legendFormat": "{{instance}}" }]
    },

    {
      "id": 6,
      "type": "stat",
      "title": "DNS lookup time",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.3 }, { "color": "red", "value": 1 }] },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "probe_dns_lookup_time_seconds{instance=~\"$target\", job=~\"$job\"}", "instant": true, "legendFormat": "{{instance}}" }]
    },

    {
      "id": 10,
      "type": "timeseries",
      "title": "Probe success over time (1 = up, 0 = down)",
      "gridPos": { "h": 7, "w": 16, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 15, "drawStyle": "line", "lineInterpolation": "stepAfter", "spanNulls": false },
          "min": 0, "max": 1.1,
          "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "probe_success{instance=~\"$target\", job=~\"$job\"}", "legendFormat": "{{instance}}" }]
    },

    {
      "id": 11,
      "type": "alertlist",
      "title": "Active alerts",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 4 },
      "options": {
        "alertInstanceLabelFilter": "instance=~\"$target\"",
        "groupMode": "default",
        "maxItems": 20,
        "sortOrder": 1,
        "stateFilter": { "error": true, "firing": true, "noData": false, "normal": false, "pending": true }
      }
    },

    {
      "id": 20,
      "type": "timeseries",
      "title": "Probe duration — full request breakdown",
      "description": "connect + TLS + processing + transfer time breakdown from Blackbox",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 1.5, "fillOpacity": 8, "spanNulls": false } }
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max", "last"] } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "probe_duration_seconds{instance=~\"$target\", job=~\"$job\"}", "legendFormat": "total — {{instance}}" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "probe_http_duration_seconds{phase=\"connect\",instance=~\"$target\", job=~\"$job\"}", "legendFormat": "connect — {{instance}}" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "probe_http_duration_seconds{phase=\"tls\",instance=~\"$target\", job=~\"$job\"}", "legendFormat": "tls — {{instance}}" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "probe_http_duration_seconds{phase=\"processing\",instance=~\"$target\", job=~\"$job\"}", "legendFormat": "processing — {{instance}}" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "probe_http_duration_seconds{phase=\"transfer\",instance=~\"$target\", job=~\"$job\"}", "legendFormat": "transfer — {{instance}}" }
      ]
    },

    {
      "id": 30,
      "type": "timeseries",
      "title": "TLS certificate expiry (days remaining)",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 14 }, { "color": "green", "value": 30 }] },
          "custom": { "lineWidth": 2 }
        }
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "(probe_ssl_earliest_cert_expiry{instance=~\"$target\", job=~\"$job\"} - time()) / 86400", "legendFormat": "{{instance}}" }]
    },

    {
      "id": 31,
      "type": "table",
      "title": "All endpoints — current state",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "custom": { "displayMode": "auto" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "probe_success" }, "properties": [
              { "id": "displayName", "value": "Status" },
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "mappings", "value": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }] }
          ]},
          { "matcher": { "id": "byName", "options": "probe_duration_seconds" }, "properties": [
              { "id": "displayName", "value": "Duration" },
              { "id": "unit", "value": "s" },
              { "id": "decimals", "value": 3 }
          ]},
          { "matcher": { "id": "byName", "options": "probe_http_status_code" }, "properties": [
              { "id": "displayName", "value": "HTTP code" },
              { "id": "decimals", "value": 0 }
          ]},
          { "matcher": { "id": "byName", "options": "cert_expiry_days" }, "properties": [
              { "id": "displayName", "value": "Cert expiry (days)" },
              { "id": "decimals", "value": 1 },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 14 }, { "color": "green", "value": 30 }] } },
              { "id": "custom.displayMode", "value": "color-text" }
          ]}
        ]
      },
      "options": { "showHeader": true, "footer": { "show": false }, "sortBy": [{ "displayName": "Status", "desc": true }] },
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true },
            "renameByName": { "instance": "Endpoint" }
        }}
      ],
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "probe_success{job=~\"$job\"}", "instant": true, "legendFormat": "" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "probe_duration_seconds{job=~\"$job\"}", "instant": true, "legendFormat": "" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "probe_http_status_code{job=~\"$job\"}", "instant": true, "legendFormat": "" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "(probe_ssl_earliest_cert_expiry{job=~\"$job\"} - time()) / 86400", "instant": true, "legendFormat": "cert_expiry_days" }
      ]
    }

  ],
  "refresh": "1m",
  "schemaVersion": 38,
  "tags": ["blackbox", "uptime", "openshift", "monitoring"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(probe_success, job)",
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "label": "Job",
        "multi": false,
        "name": "job",
        "query": { "query": "label_values(probe_success, job)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(probe_success{job=~\"$job\"}, instance)",
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "label": "Target",
        "multi": true,
        "name": "target",
        "query": { "query": "label_values(probe_success{job=~\"$job\"}, instance)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Blackbox exporter — endpoint uptime",
  "uid": "blackbox-uptime",
  "version": 1
}
