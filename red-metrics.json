{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source scraping traces_span_metrics_* generated by the OTel Collector spanmetrics connector",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "title": "RED Metrics (Spanmetrics)",
  "uid": "red-metrics-spanmetrics",
  "description": "Request rate, error rate, and duration derived from traces_span_metrics_calls / traces_span_metrics_duration_bucket, generated by the OTel Collector spanmetrics connector from trace data.",
  "tags": ["tracing", "spanmetrics", "red-metrics", "otel"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "label": "Data source",
        "hide": 0
      },
      {
        "name": "service_name",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "query": "label_values(traces_span_metrics_calls, service_name)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {"text": "All", "value": "$__all"},
        "label": "Service"
      },
      {
        "name": "span_name",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "query": "label_values(traces_span_metrics_calls{service_name=~\"$service_name\"}, span_name)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {"text": "All", "value": "$__all"},
        "label": "Span name"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total Request Rate",
      "description": "sum(rate(traces_span_metrics_calls[5m])) across selected services/spans",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 1},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(rate(traces_span_metrics_calls{service_name=~\"$service_name\", span_name=~\"$span_name\"}[5m]))",
          "legendFormat": "Requests/sec",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error Rate (5xx)",
      "description": "sum(rate) of calls with http.response.status_code in 5xx range",
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 1},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.01},
              {"color": "red", "value": 0.1}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(rate(traces_span_metrics_calls{service_name=~\"$service_name\", span_name=~\"$span_name\", http_response_status_code=~\"5..\"}[5m]))",
          "legendFormat": "Errors/sec",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Error Percentage",
      "description": "Errors as a percentage of total calls",
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 1},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 5}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "graphMode": "area",
        "colorMode": "background",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "100 * sum(rate(traces_span_metrics_calls{service_name=~\"$service_name\", span_name=~\"$span_name\", http_response_status_code=~\"5..\"}[5m])) / sum(rate(traces_span_metrics_calls{service_name=~\"$service_name\", span_name=~\"$span_name\"}[5m]))",
          "legendFormat": "Error %",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "p99 Latency",
      "description": "99th percentile latency across selected services/spans",
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 1},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.5},
              {"color": "red", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(traces_span_metrics_duration_bucket{service_name=~\"$service_name\", span_name=~\"$span_name\"}[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Rate, Errors, Duration by Span",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 6},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Request Rate by span_name",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 7},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never"}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max", "lastNotNull"]},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {
          "expr": "sum(rate(traces_span_metrics_calls{service_name=~\"$service_name\", span_name=~\"$span_name\"}[5m])) by (span_name)",
          "legendFormat": "{{span_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Error Rate by span_name (5xx)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 7},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never"},
          "color": {"mode": "fixed", "fixedColor": "red"}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max", "lastNotNull"]},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {
          "expr": "sum(rate(traces_span_metrics_calls{service_name=~\"$service_name\", span_name=~\"$span_name\", http_response_status_code=~\"5..\"}[5m])) by (span_name)",
          "legendFormat": "{{span_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "p50 / p95 / p99 Latency (overall)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 5, "showPoints": "never"}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max", "lastNotNull"]},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(traces_span_metrics_duration_bucket{service_name=~\"$service_name\", span_name=~\"$span_name\"}[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(traces_span_metrics_duration_bucket{service_name=~\"$service_name\", span_name=~\"$span_name\"}[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(traces_span_metrics_duration_bucket{service_name=~\"$service_name\", span_name=~\"$span_name\"}[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "p99 Latency by span_name",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 5, "showPoints": "never"}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max", "lastNotNull"]},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(traces_span_metrics_duration_bucket{service_name=~\"$service_name\", span_name=~\"$span_name\"}[5m])) by (le, span_name))",
          "legendFormat": "{{span_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Span Summary (rate / errors / p99)",
      "description": "Combined table view per span_name for quick scanning",
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 23},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {"custom": {"align": "auto"}},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Value #A"},
            "properties": [{"id": "displayName", "value": "Request Rate (req/s)"}]
          },
          {
            "matcher": {"id": "byName", "options": "Value #B"},
            "properties": [{"id": "displayName", "value": "Error Rate (req/s)"}]
          },
          {
            "matcher": {"id": "byName", "options": "Value #C"},
            "properties": [{"id": "displayName", "value": "p99 Latency (s)"}]
          }
        ]
      },
      "options": {"showHeader": true},
      "transformations": [
        {"id": "merge", "options": {}}
      ],
      "targets": [
        {
          "expr": "sum(rate(traces_span_metrics_calls{service_name=~\"$service_name\", span_name=~\"$span_name\"}[5m])) by (span_name)",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "sum(rate(traces_span_metrics_calls{service_name=~\"$service_name\", span_name=~\"$span_name\", http_response_status_code=~\"5..\"}[5m])) by (span_name)",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(traces_span_metrics_duration_bucket{service_name=~\"$service_name\", span_name=~\"$span_name\"}[5m])) by (le, span_name))",
          "format": "table",
          "instant": true,
          "refId": "C"
        }
      ]
    }
  ]
}
